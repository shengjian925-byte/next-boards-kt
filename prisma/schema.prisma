generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model AnonPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @default("名無しさん")
  title     String
  content   String
  createdAt DateTime @default(now())
}
