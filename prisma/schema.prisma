generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model AnonPost {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      String      @default("名無しさん")
  title     String
  content   String
  image     String?
  likes     Int         @default(0)
  createdAt DateTime    @default(now())
  replies   AnonReply[]
}

model AnonReply {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      AnonPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String   @default("名無しさん")
  content   String
  image     String?
  createdAt DateTime @default(now())
}
